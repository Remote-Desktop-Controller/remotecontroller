RDC_DOMAIN=pc.seu-dominio.com
RDC_TLS_EMAIL=seu-email@example.com
# ChatGPT/Codex elegíveis usam este callback estável com RFC 9207.
# A allowlist é explícita: mantenha somente os callbacks exatos autorizados.
# Vazio bloqueia DCR; nunca use wildcard. Outros clientes exigem sua URI exata.
RDC_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect
