{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RDC Maestro",
  "version": "0.5.0",
  "identifier": "com.rdc.maestro",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "RDC Maestro - Multi-Agent Desktop IDE",
        "label": "main",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
