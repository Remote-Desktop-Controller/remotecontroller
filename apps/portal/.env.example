# Portal independente. Root Directory da Vercel: apps/portal.
# Use primeiro o endereço temporário https://SEU-PROJETO.vercel.app.
PORTAL_PUBLIC_URL=http://localhost:3000
# Somente desenvolvimento local; manter false na Vercel.
PORTAL_ALLOW_HTTP_LOOPBACK=true

# Configuração pública Supabase (URL e chave anon/publicável).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor: Settings/API do projeto. Nunca NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Preço Premium fixo no servidor: R$ 9,90 por 30 dias.
PORTAL_PRICE_CENTS=990
# Ativar somente após migrations, agente e serviço compatíveis validados.
FREE_DAILY_ENABLED=false
# Não habilitar pagamentos reais antes de preencher condições comerciais.
SALES_ENABLED=false
ASAAS_ENV=sandbox
ASAAS_API_KEY=
# Segredo aleatório independente com pelo menos 32 caracteres.
ASAAS_WEBHOOK_TOKEN=

# Pré-venda e transparência. Não inventar prazo/identidade/contato.
DELIVERY_DEADLINE=
SUPPORT_EMAIL=
LEGAL_OPERATOR_NAME=
REFUND_POLICY=
# Lista de UUIDs Supabase autorizados a administrar, separada por vírgulas.
ADMIN_USER_IDS=
# Opcional: URL HTTPS do artefato do agente compatível quando publicado.
AGENT_DOWNLOAD_URL=

# Só preencher quando houver VPS pronta; não ativar por comprar a VPS apenas.
REMOTE_SERVICE_AVAILABLE=false
MCP_SERVICE_ORIGIN=
# Mesmo segredo configurado na VPS, separado do webhook e da chave Asaas.
MCP_SHARED_SECRET=
